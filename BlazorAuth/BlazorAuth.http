@BlazorAuth_HostAddress = https://localhost:7261

### Register User
POST {{BlazorAuth_HostAddress}}/account/user/register
Content-Type: application/json

{
  "firstname" : "Jean",
  "lastname" : "Tomines",
  "password" : "123@test",
  "role" : 1
}

### Login User
POST {{BlazorAuth_HostAddress}}/account/user/login
Content-Type: application/json
{
  "username" : "JeanTomines",
  "password" : "123@test"
}

###

GET {{BlazorAuth_HostAddress}}/account/user/verify

###
