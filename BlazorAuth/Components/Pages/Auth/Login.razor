@page "/Account/User/Login"

@using BlazorAuth.Auth

@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject HttpClient http
@inject AuthService authService

@rendermode InteractiveServer

<div class="mx-auto w-[450px] rounded-md border border-gray-300">
    <EditForm Model="@LoginModel" OnValidSubmit="HandleLogin">
        <div class="relative px-4 py-6">
            <p class="mb-2 font-bold">Last Name</p>
            <InputText @bind-Value="LoginModel.Username"
                       typeof="text" placeholder="Lastname"
                       class="mb-4 w-full rounded-md border border-gray-300 px-4 py-4" />

            <p class="mb-2 font-bold">Password</p>
            <InputText type="password" @bind-Value="LoginModel.Password"
                       typeof="text" placeholder="Password"
                       class="mb-6 w-full rounded-md border border-gray-300 px-4 py-4" />

            <button type="submit" class="w-full cursor-pointer rounded-md bg-violet-600 px-4 py-4 text-white">Register</button>
        </div>
    </EditForm>
</div>

@code
{
    public CredsRequest LoginModel = new CredsRequest();
    private bool isLoading = false;
    private string? ErrorMessage;

    public async Task HandleLogin()
    {
        isLoading = true;
        try
        {
            bool IsVerified = await authService.IsUserVerified(LoginModel);

            if (IsVerified)
            {
                await authService.LoginAsync(LoginModel);

                var session = new UserSession
                {
                    UserName = LoginModel.Username,
                    Role = "Member"
                };
               
                var customAuth = (CustomAuthenticationStateProvider)AuthStateProvider;

                await customAuth.LoginAsync(session);
                
                NavManager.NavigateTo("/");
            }     
        }
        catch(Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}