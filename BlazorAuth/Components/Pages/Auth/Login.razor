@page "/Account/Login"

@using BlazorAuth.Auth


@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

@rendermode InteractiveServer

<div class="mx-auto w-[450px] rounded-md border border-gray-300">
    <EditForm Model="@LoginModel">
        <div class="relative px-4 py-6">
            <p class="mb-2 font-bold">Last Name</p>
            <InputText @bind-Value="LoginModel.Username"
                       typeof="text" placeholder="Lastname"
                       class="mb-4 w-full rounded-md border border-gray-300 px-4 py-4" />

            <p class="mb-2 font-bold">Password</p>
            <InputText type="password" @bind-Value="LoginModel.Password"
                       typeof="text" placeholder="Password"
                       class="mb-6 w-full rounded-md border border-gray-300 px-4 py-4" />

            <button type="submit" @onsubmit="HandleLogin" class="w-full cursor-pointer rounded-md bg-violet-600 px-4 py-4 text-white">Register</button>
        </div>
    </EditForm>
</div>

@code
{
    public LoginViewModel LoginModel { get; set; } = new LoginViewModel();

    public async Task HandleLogin()
    {
        var customAuth = (CustomAuthenticationStateProvider)AuthStateProvider;
        await customAuth.UpdateAuthenticationState(new UserSession
        {
            UserName = LoginModel.Username,
            Role = "Member"
        });
        NavManager.NavigateTo("/Account/Login", true);
    }
}